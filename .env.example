# Copy this file to ".env" and paste your keys after the "=" sign.
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=

# Optional tuning (safe to leave as-is)
ASSEMBLYAI_SPEECH_MODEL=universal-3-6-pro
ASSEMBLYAI_SPEAKER_LABELS=true
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-120b
ANALYSIS_INTERVAL_SECONDS=12
